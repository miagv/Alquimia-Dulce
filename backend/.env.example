# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database provided by Supabase
SUPABASE_NAME=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=replace-with-your-database-password
SUPABASE_HOST=db.your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_SSLMODE=require

# Frontend origins allowed to call the Django API
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Email; console is convenient during local development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Mercado Pago. Leave blank until sandbox or production credentials are available.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_NOTIFICATION_URL=
